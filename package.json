		"@langchain/langgraph": "^0.4.9",
		"@langchain/openai": "^0.6.16",
		"@modelcontextprotocol/sdk": "^1.20.0",
		"bits-ui": "^2.14.2",
		"marked": "^16.4.0",
		"mermaid": "^11.12.0",
